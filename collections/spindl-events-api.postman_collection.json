              "raw": "[\n  {\n    \"type\": \"<string>\",\n    \"data\": {\n      \"name\": \"<string>\",\n      \"properties\": \"<object>\"\n    },\n    \"identity\": {\n      \"address\": \"<string>\",\n      \"customerUserId\": \"<string>\"\n    }\n  },\n  {\n    \"type\": \"<string>\",\n    \"data\": {\n      \"name\": \"<string>\",\n      \"properties\": \"<object>\"\n    },\n    \"identity\": {\n      \"address\": \"<string>\",\n      \"customerUserId\": \"<string>\"\n    }\n  }\n]",
